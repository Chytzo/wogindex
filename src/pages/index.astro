---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readFileSync } from 'node:fs';
const B = import.meta.env.BASE_URL;
const heroes = JSON.parse(readFileSync(process.cwd() + '/src/data/' + 'heroes.json', 'utf-8'));
const equip = JSON.parse(readFileSync(process.cwd() + '/src/data/' + 'equip.json', 'utf-8'));
const items = JSON.parse(readFileSync(process.cwd() + '/src/data/' + 'items.json', 'utf-8'));
const monsters = JSON.parse(readFileSync(process.cwd() + '/src/data/' + 'monsters.json', 'utf-8'));
const stages = JSON.parse(readFileSync(process.cwd() + '/src/data/' + 'stages.json', 'utf-8'));
const skills = JSON.parse(readFileSync(process.cwd() + '/src/data/' + 'skills.json', 'utf-8'));
const stats = [
  ["Heroes", heroes.length, "heroes", "text-gold"],
  ["Equipment", equip.length, "equip", "text-green-400"],
  ["Items", items.length, "items", "text-purple-400"],
  ["Monsters", monsters.length, "monsters", "text-red-400"],
  ["Skills", skills.length, "skills", "text-blue-400"],
  ["Stages", stages.length, "stages", "text-orange-400"],
];
const explore = [
  ["Market & Prices", "heroes", "Browse every hero with stats and classes."],
  ["Gear Database", "equip", "Equipment, weapons and machina with qualities."],
  ["Crafting Materials", "items", "Consumables, materials and quest items."],
  ["Monster Bestiary", "monsters", "All monsters and their drop tables."],
  ["Heroes & Skill Trees", "skills", "Active and passive skills."],
  ["Stages", "stages", "Stage list with groups and rewards."],
];
---
<BaseLayout title="War of Genesis: Idle Loot Database & Wiki">
  <h1 class="font-pixel text-xl md:text-2xl text-gold mb-3 mt-2">War of Genesis: Idle Loot Database &amp; Wiki</h1>
  <p class="text-mud max-w-3xl leading-relaxed">Complete datamined database for War of Genesis: Idle Loot — heroes, equipment, items, monsters, stages, gacha and drop tables. Unofficial fan wiki, updated from game data.</p>

  <section class="mt-8">
    <h2 class="font-pixel text-[13px] text-accent mb-4">Quick stats</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      {stats.map(([label, count, href, color]) => (
        <a href={`${B}${href}`} class="bg-dark-card border border-dark-border rounded-lg p-4 hover:border-gold hover:-translate-y-0.5 transition group">
          <div class={`font-pixel text-lg ${color}`}>{count}</div>
          <div class="text-xs text-mud mt-1.5 group-hover:text-cream transition">{label}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-8">
    <h2 class="font-pixel text-[13px] text-accent mb-4">Explore WoG Index</h2>
    <div class="grid md:grid-cols-3 gap-3">
      {explore.map(([label, href, desc]) => (
        <a href={`${B}${href}`} class="bg-dark-card border border-dark-border rounded-lg p-4 hover:border-gold transition group">
          <div class="text-sm font-bold text-gold">{label}</div>
          <div class="text-xs text-mud mt-1 group-hover:text-cream/80 transition">{desc}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-pixel text-[13px] text-accent">Featured Heroes</h2>
      <a href={`${B}heroes`} class="text-xs text-gold hover:underline">View all →</a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {heroes.slice(0, 8).map((h, i) => (
        <a href={`${B}heroes/${i}`} class="bg-dark-card border border-dark-border rounded-lg p-4 hover:border-gold transition group">
          <div class="text-xl font-bold text-gold">{h.name_en || h.name_es || `Hero ${i}`}</div>
          <div class="text-xs text-mud mt-1">ID {h.row[0]} · Quality {h.row[2]}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-pixel text-[13px] text-accent mb-4">Frequently asked questions</h2>
    <div class="bg-dark-card border border-dark-border rounded-lg divide-y divide-dark-border">
      <div class="p-4">
        <div class="font-bold text-cream">Is WoG Index official?</div>
        <p class="text-mud text-sm mt-1 leading-relaxed max-w-3xl">No. WoG Index is an independent, unofficial fan database for War of Genesis: Idle Loot, a game by <b>ANTIGO</b>. It is not affiliated with or endorsed by the developer.</p>
      </div>
      <div class="p-4">
        <div class="font-bold text-cream">Where does the data come from?</div>
        <p class="text-mud text-sm mt-1 leading-relaxed max-w-3xl">Data is extracted directly from the game's own tables (msgpack .bin files). Names are resolved via the bundled locale files so they match what you see in game.</p>
      </div>
      <div class="p-4">
        <div class="font-bold text-cream">Is it free?</div>
        <p class="text-mud text-sm mt-1 leading-relaxed max-w-3xl">Yes. Every section — heroes, gear, items, monsters, stages, gacha and drop tables — is completely free, with no login required.</p>
      </div>
    </div>
  </section>
</BaseLayout>